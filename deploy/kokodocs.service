[Unit]
Description=KokoDocs
After=network.target

[Service]
User=kokodocs
WorkingDirectory=/opt/kokodocs/backend
Environment=KOKO_DATA_DIR=/var/lib/kokodocs
# Optional: Environment=KOKO_SECRET=<long random string>
# gunicorn_conf.py: ONE worker (open documents live in the process), reloads by itself when backend/*.py changes, with no downtime.
Environment=KOKO_BIND=127.0.0.1:8000 KOKO_FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/kokodocs/backend/.venv/bin/gunicorn -c app/gunicorn_conf.py app.main:app
# sudo systemctl reload kokodocs  reloads on demand, with no downtime
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
