{
  "name": "kokodocs-desktop",
  "version": "1.0.0",
  "description": "KokoDocs for Mac, Windows and Linux: the web app in its own window, with an offline copy of everything.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cc.kokodev.kokodocs",
    "productName": "KokoDocs",
    "files": [
      "main.js",
      "preload.js",
      "pages/**",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "KokoDocs uses the camera in meetings.",
        "NSMicrophoneUsageDescription": "KokoDocs uses the microphone in meetings and for voice typing."
      },
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "KokoDocs-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "KokoDocs-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "KokoDocs-Portable-${arch}.${ext}"
    }
  },
  "author": {
    "name": "KokoDocs",
    "email": "kokodocs@users.noreply.github.com"
  },
  "homepage": "https://github.com/kokofixcomputers/kokodocs"
}
